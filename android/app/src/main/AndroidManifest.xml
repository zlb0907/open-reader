<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.openreader.app"
    android:versionCode="15"
    android:versionName="1.16.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 8+ 应用内更新必须声明；运行时还要用户放行「安装未知应用」一次。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="开放书库"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 零依赖 FileProvider 等价物：只把 files/apk/update.apk 以 content:// 交给系统安装器。
             exported=false + grantUriPermissions=true，配合 Intent 的临时 URI 授权。 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.openreader.app.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
